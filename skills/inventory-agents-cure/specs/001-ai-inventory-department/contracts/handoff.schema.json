{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finance-agents-cure/handoff.schema.json",
  "title": "Maker handoff (accountant -> chief accountant)",
  "type": "object",
  "required": [
    "role",
    "period",
    "site",
    "task",
    "data_as_of",
    "branches_covered",
    "summary_ar",
    "findings",
    "status"
  ],
  "properties": {
    "role": {
      "type": "string",
      "description": "id from config/roles.json"
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "site": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "data_as_of": {
      "type": "string",
      "description": "timestamp of the Cure pull used"
    },
    "branches_covered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "branches_missing": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "branches or folders that could not be reached"
    },
    "summary_ar": {
      "type": "string"
    },
    "totals": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "title_ar",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "stable id so the finding can be re-checked next run"
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "title_ar": {
            "type": "string"
          },
          "detail_ar": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "rule": {
            "type": "string",
            "description": "rules file + line the finding rests on"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "branch",
                "ref"
              ],
              "properties": {
                "branch": {
                  "type": "string"
                },
                "ref": {
                  "type": "string",
                  "description": "voucher / invoice / claim / staff number"
                },
                "account": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "narration": {
                  "type": "string"
                }
              }
            }
          },
          "status": {
            "enum": [
              "new",
              "still_open",
              "partly_fixed",
              "fixed",
              "unverified"
            ]
          },
          "blocks_close": {
            "type": "boolean",
            "description": "true = the period must not be closed until this is resolved"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "workpapers written under runs/<period>/<role>/"
    },
    "status": {
      "enum": [
        "ready_for_review",
        "blocked"
      ]
    },
    "blocked_reason_ar": {
      "type": "string"
    },
    "review": {
      "type": "object",
      "description": "filled by chief-accountant",
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "returned"
          ]
        },
        "notes_ar": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewed_at": {
          "type": "string"
        }
      }
    },
    "scope_notes_ar": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "what was deliberately out of scope or not checked (e.g. attachment contents not read) — not the same as branches_missing"
    },
    "referrals": {
      "type": "array",
      "description": "items handed to another role; the receiving role must answer them in its own handoff",
      "items": {
        "type": "object",
        "required": [
          "to_role",
          "id",
          "note_ar"
        ],
        "properties": {
          "to_role": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "note_ar": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "status": {
            "enum": [
              "open",
              "answered"
            ]
          },
          "answer_ar": {
            "type": "string"
          }
        }
      }
    },
    "model_used": {
      "type": "string",
      "description": "model the run used (haiku/sonnet/opus)"
    },
    "model_escalation": {
      "type": "object",
      "description": "set by the agent when it needs a stronger model",
      "properties": {
        "requested": {
          "enum": [
            "sonnet",
            "opus"
          ]
        },
        "reason_ar": {
          "type": "string"
        }
      }
    }
  }
}